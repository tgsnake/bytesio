{
  "name": "@tgsnake/bytesio",
  "packageManager": "yarn@4.18.1",
  "version": "2.1.0",
  "description": "A simple BytesIO implementation for Typescript",
  "main": "dist/mod.js",
  "types": "dist/mod.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:jsr": "node ./generator/jsr_version/index.js",
    "clean": "rm -rf dist",
    "prepare": "yarn build",
    "prettier": "NODE_OPTIONS=--max_old_space_size=4096 prettier -w ."
  },
  "homepage": "https://tgsnake.js.org",
  "keywords": [
    "tgsnake",
    "BytesIO",
    "Buffer"
  ],
  "bugs": "https://github.com/tgsnake/bytesio/issues",
  "repository": "https://github.com/tgsnake/bytesio",
  "author": "butthx",
  "files": [
    "dist/**/**"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=6.0.0",
    "yarn": ">=1.0.0",
    "deno": ">=1.0.0",
    "bun": ">=1.0.0"
  }
}
